#!/bin/sh

set -e

undivert() {
    dpkg-divert --package pve-cloudprovision --remove --rename \
        --divert "$1.pve-cloudprovision-orig" "$1" >/dev/null
}

case "$1" in
    remove|abort-install|disappear)
        undivert /usr/share/perl5/PVE/API2/Nodes.pm
        ;;
esac

#DEBHELPER#

exit 0
