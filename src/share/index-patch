#!/usr/bin/perl

# Add (apply) or remove (revert) the pve-cloudprovision script tag in the Proxmox VE
# web UI index template. Called by the maintainer scripts, re-applied by a dpkg
# trigger whenever pve-manager ships a new template.

use strict;
use warnings;

my $TPL = '/usr/share/pve-manager/index.html.tpl';
my $VERSION = '@VERSION@';

my $action = shift // '';
die "usage: $0 apply|revert\n" if $action !~ m/^(?:apply|revert)$/;

exit(0) if !-f $TPL;

open(my $fh, '<', $TPL) or die "unable to read $TPL - $!\n";
my $raw = do { local $/; <$fh> };
close($fh);

my $new = $raw =~ s{^[ \t]*<script\b[^\n]*/pve-cloudprovision\.js[^\n]*\n}{}mgr;

if ($action eq 'apply') {
    my $tag = qq{    <script type="text/javascript" src="/pve2/js/pve-cloudprovision.js?ver=$VERSION"></script>\n};
    if ($new !~ s{^([^\n]*/pvemanagerlib\.js[^\n]*\n)}{$1$tag}m) {
        warn "pve-cloudprovision: pvemanagerlib.js not referenced in $TPL, web UI not extended\n";
        exit(0);
    }
}

exit(0) if $new eq $raw;

my $tmp = "$TPL.pve-cloudprovision.tmp";
open(my $out, '>', $tmp) or die "unable to write $tmp - $!\n";
print {$out} $new or die "unable to write $tmp - $!\n";
close($out) or die "unable to write $tmp - $!\n";
chmod((stat($TPL))[2] & 07777, $tmp);
rename($tmp, $TPL) or die "unable to replace $TPL - $!\n";

exit(0);
